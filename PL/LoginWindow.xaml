<Window x:Class="PL.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="620"
        Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6FA">

    <Window.Resources>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox -->
        <Style x:Key="InputTextStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="InputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CFD8DC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Left Side (Brand) -->
        <Grid Width="300"
              HorizontalAlignment="Left">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E88E5" Offset="0"/>
                    <GradientStop Color="#0D47A1" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center"
                        Margin="40">

                <TextBlock Text="Delivery"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Management System"
                           FontSize="16"
                           Foreground="#BBDEFB"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Authorized access only"
                           FontSize="12"
                           Foreground="#E3F2FD"/>
            </StackPanel>
        </Grid>

        <!-- Right Side (Login Form) -->
        <Border Margin="300,40,40,40"
                Background="White"
                CornerRadius="16"
                Padding="40">

            <StackPanel>

                <TextBlock Text="Sign In"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#263238"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Use your ID and password"
                           FontSize="13"
                           Foreground="#78909C"
                           Margin="0,0,0,30"/>

                <!-- ID -->
                <TextBlock Text="ID Number"
                           FontSize="12"
                           Foreground="#546E7A"/>
                <TextBox x:Name="tbId"
                         Style="{StaticResource InputTextStyle}"
                         Margin="0,6,0,20"
                         KeyDown="TbId_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="12"
                           Foreground="#546E7A"/>

                <Grid Margin="0,6,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="pbPassword"
                                 Style="{StaticResource InputPasswordStyle}"
                                 KeyDown="PbPassword_KeyDown"/>

                    <TextBox x:Name="tbPasswordVisible"
                             Visibility="Collapsed"
                             Style="{StaticResource InputTextStyle}"
                             KeyDown="PbPassword_KeyDown"/>

                    <Button x:Name="btnTogglePassword"
                            Grid.Column="1"
                            Content="Show"
                            Style="{StaticResource IconButtonStyle}"
                            Click="BtnTogglePassword_Click"/>
                </Grid>

                <!-- Login -->
                <Button Content="Login"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,12"
                        Click="BtnLogin_Click"/>

                <!-- Close -->
                <Button Content="Close"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="#B0BEC5"
                        Click="BtnClose_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
