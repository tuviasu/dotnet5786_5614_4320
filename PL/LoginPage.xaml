<Window x:Class="PL.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DeliveryApp - Login"
        Height="620"
        Width="980"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#0F172A">

    <Grid>
        <!-- ===================== Background: deep tech gradient ===================== -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1220" Offset="0"/>
                <GradientStop Color="#111C34" Offset="0.55"/>
                <GradientStop Color="#0E1B3A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Ambient glow blobs (premium depth) -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-120" Canvas.Top="-120" Width="420" Height="420" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="600" Canvas.Top="320" Width="520" Height="520" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Subtle circuit grid overlay -->
        <Path Stroke="#1E3A5F" StrokeThickness="1" Opacity="0.25" IsHitTestVisible="False"
              Data="M0,120 H980 M0,240 H980 M0,360 H980 M0,480 H980 M160,0 V620 M320,0 V620 M480,0 V620 M640,0 V620 M800,0 V620"/>

        <!-- ===================== Two-column layout ===================== -->
        <Grid Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Left: brand / hero panel ============ -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,0,0">

                <!-- Brand mark: vector chip + package motif -->
                <Grid Width="64" Height="64" Margin="0,0,0,22" HorizontalAlignment="Left">
                    <Rectangle Width="64" Height="64" RadiusX="16" RadiusY="16">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#4F46E5" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.55" Color="#2563EB"/>
                        </Rectangle.Effect>
                    </Rectangle>
                    <!-- stylised delivery box -->
                    <Path Stretch="Uniform" Width="34" Height="34" Fill="White" Margin="0"
                          Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"/>
                </Grid>

                <TextBlock Text="DeliveryApp"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#F8FAFC"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Desktop Logistics &amp; Delivery Control Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#93C5FD"
                           Margin="0,0,0,18"/>

                <TextBlock Text="A specialized delivery management platform for computer"
                           FontSize="13"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"/>
                <TextBlock Text="hardware &amp; electronics retailers — orders, couriers, live deliveries."
                           FontSize="13"
                           Foreground="#94A3B8"
                           TextWrapping="Wrap"
                           Margin="0,0,0,26"/>

                <!-- Feature bullets -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Stretch="Uniform" Width="14" Height="14" Fill="#22C55E" VerticalAlignment="Center"
                          Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
                    <TextBlock Text="Real-time order &amp; courier dashboard"
                               Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Stretch="Uniform" Width="14" Height="14" Fill="#22C55E" VerticalAlignment="Center"
                          Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
                    <TextBlock Text="Role-based access: Admin &amp; Courier"
                               Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Stretch="Uniform" Width="14" Height="14" Fill="#22C55E" VerticalAlignment="Center"
                          Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/>
                    <TextBlock Text="Secure operations &amp; live shipment tracking"
                               Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ Right: login card ============ -->
            <Border Grid.Column="2"
                    CornerRadius="22"
                    Padding="36"
                    Background="#F8FAFC"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.45" Color="#0B1220"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Card header -->
                    <TextBlock Text="Welcome Back"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to your account to continue"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,6,0,24"
                               HorizontalAlignment="Center"/>

                    <!-- Role chips -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                        <Border CornerRadius="12" Padding="10,4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1">
                            <TextBlock Text="🛡  Admin / Manager" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </Border>
                        <Border CornerRadius="12" Padding="10,4" Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1" Margin="8,0,0,0">
                            <TextBlock Text="🚚  Courier" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                        </Border>
                    </StackPanel>

                    <!-- User ID -->
                    <TextBlock Text="User ID" Style="{StaticResource AppFieldLabel}"/>
                    <TextBox x:Name="txtUserId"
                             Style="{StaticResource AppTextBox}"
                             FontSize="14"/>

                    <!-- Password -->
                    <TextBlock Text="Password" Style="{StaticResource AppFieldLabel}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="pwdBox"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     Background="#FFFFFF"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="#2563EB"/>

                        <TextBox x:Name="txtPasswordVisible"
                                 Grid.Column="0"
                                 Style="{StaticResource AppTextBox}"
                                 Visibility="Collapsed"/>

                        <ToggleButton x:Name="btnShowPassword"
                                      Grid.Column="1"
                                      Margin="6,0,0,0"
                                      Width="38"
                                      Height="38"
                                      Cursor="Hand"
                                      Checked="ShowPassword_Checked"
                                      Unchecked="ShowPassword_Unchecked">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="eb" Background="#E2E8F0" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="eb" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="eb" Property="Background" Value="#2563EB"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Path x:Name="eyeIcon" Stretch="Uniform" Width="18" Height="18" Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                                  Data="M12 5c-7.6 0-10 7-10 7s2.4 7 10 7 10-7 10-7-2.4-7-10-7zm0 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/>
                        </ToggleButton>
                    </Grid>

                    <!-- Inline validation feedback -->
                    <Border x:Name="errorBar"
                            CornerRadius="10"
                            Padding="12,8"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Stretch="Uniform" Width="16" Height="16" Fill="#DC2626" VerticalAlignment="Center"
                                  Data="M12 2 1 21h22L12 2zm0 6 6 11H6l6-11zm-1 4v3h2v-3h-2zm0 4v2h2v-2h-2z"/>
                            <TextBlock x:Name="txtError" FontSize="12" Foreground="#B91C1C"
                                       VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="btnLogin"
                                Content="Sign In"
                                Width="150"
                                Height="44"
                                FontWeight="SemiBold"
                                FontSize="15"
                                Style="{StaticResource AppPrimaryButton}"
                                Click="btnLogin_Click"/>
                        <Button Content="Close"
                                Width="120"
                                Height="44"
                                Margin="12,0,0,0"
                                FontWeight="SemiBold"
                                FontSize="14"
                                Style="{StaticResource AppSecondaryButton}"
                                Click="btnClose_Click"/>
                    </StackPanel>

                    <!-- Helper hint -->
                    <TextBlock Text="Use your assigned numeric ID and password."
                               FontSize="11"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>