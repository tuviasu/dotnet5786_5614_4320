<Window x:Class="PL.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Login"
        Height="480"
        Width="760"
        MinHeight="420"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <!-- Background Gradient -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Login Card -->
        <Border Width="420"
                Padding="32"
                CornerRadius="20"
                Background="#F8FAFC"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Welcome Back"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Please sign in to continue"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,28"
                           HorizontalAlignment="Center"/>

                <!-- ID -->
                <TextBlock Text="User ID"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="txtUserId"
                         Height="40"
                         Padding="10,0"
                         FontSize="14"
                         Background="#FFFFFF"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,18,0,6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="pwdBox"
                                 Height="40"
                                 Padding="10,0"
                                 FontSize="14"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>

                    <TextBox x:Name="txtPasswordVisible"
                             Grid.Column="0"
                             Height="40"
                             Padding="10,0"
                             FontSize="14"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"/>

                    <ToggleButton x:Name="btnShowPassword"
                                  Grid.Column="1"
                                  Margin="6,0,0,0"
                                  Width="36"
                                  Height="36"
                                  Content="👁"
                                  FontSize="14"
                                  Background="#E2E8F0"
                                  BorderThickness="0"
                                  Checked="ShowPassword_Checked"
                                  Unchecked="ShowPassword_Unchecked"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">

                    <Button x:Name="btnLogin"
                            Content="Login"
                            Width="120"
                            Height="40"
                            FontWeight="SemiBold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnLogin_Click"/>

                    <Button Content="Close"
                            Width="120"
                            Height="40"
                            Margin="12,0,0,0"
                            FontWeight="SemiBold"
                            Background="#E5E7EB"
                            Foreground="#334155"
                            BorderThickness="0"
                            Click="btnClose_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
