<Window x:Class="PL.Courier.ChooseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Order Selection"
        Height="520"
        Width="820"
        MinHeight="460"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ===================== -->
    <!-- Layout Root           -->
    <!-- ===================== -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- Header Bar            -->
        <!-- ===================== -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="10"
                Padding="14"
                BorderBrush="#DDD"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Available Orders"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="Select an order to start handling"
                               Foreground="#666"
                               FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Width="36"
                        Height="36"
                        FontSize="16"
                        Background="#EEE"
                        BorderThickness="0"
                        Click="btnClose_Click"/>
            </Grid>
        </Border>

        <!-- ===================== -->
        <!-- Orders Table          -->
        <!-- ===================== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="8"
                BorderBrush="#DDD"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowBackground="#FAFAFA"
                      AlternatingRowBackground="#F1F3F6">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding OrderID}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Order Type"
                                        Binding="{Binding orderType}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Delivery Address"
                                        Binding="{Binding FullAddress}"
                                        Width="3*"/>

                    <DataGridTextColumn Header="Distance (km)"
                                        Binding="{Binding AirDistance}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Schedule Status"
                                        Binding="{Binding scheduleStatus}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Remaining Time"
                                        Binding="{Binding TimeRemainingToComplete}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===================== -->
        <!-- Action Buttons        -->
        <!-- ===================== -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button Content="Refresh List"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#E0E6F8"
                    BorderThickness="0"
                    Click="btnRefresh_Click"/>

            <Button Content="Confirm Selection"
                    Width="160"
                    Height="40"
                    Background="#4F6EF7"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="btnSelect_Click"/>
        </StackPanel>

    </Grid>
</Window>
