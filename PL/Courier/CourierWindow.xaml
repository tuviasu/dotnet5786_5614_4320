<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courier"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= Courier FIELDS ================= -->

            <!-- Courier ID -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Courier ID:"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     IsReadOnly="False"/>

            <!-- Start Working Date -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Working Date:"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding CurrentCourier.StartWorkingDate}"
                     IsReadOnly="True"/>

            <!-- Password (masked bullets) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding PasswordMask}"
                     IsReadOnly="False"
                     FontFamily="Segoe UI Symbol"/>

            <!-- ================= BUSINESS FIELDS ================= -->

            <!-- Name -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Name:"/>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding CurrentCourier.Name, Mode=TwoWay}"/>

            <!-- Phone -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone:"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding CurrentCourier.Phone, Mode=TwoWay}"/>

            <!-- Email -->
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Email:"/>
            <TextBox Grid.Row="5" Grid.Column="1"
                     Text="{Binding CurrentCourier.Email, Mode=TwoWay}"/>

            <!-- Transport -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Transport:"/>
            <ComboBox Grid.Row="6" Grid.Column="1"
                      ItemsSource="{Binding CourierTypes}"
                      SelectedItem="{Binding CurrentCourier.Transport, Mode=TwoWay}"/>

            <!-- Max Range -->
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Max Range:"/>
            <TextBox Grid.Row="7" Grid.Column="1"
                     Text="{Binding CurrentCourier.MaxRange, Mode=TwoWay}"/>

            <!-- Active -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Active:"/>
            <CheckBox Grid.Row="8" Grid.Column="1"
                      IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay}"/>

            <!-- ================= CALCULATED / READ ONLY ================= -->

            <!-- Deliveries On Time -->
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Deliveries On Time:"/>
            <TextBox Grid.Row="9" Grid.Column="1"
                     Text="{Binding CurrentCourier.DeliveriesCountOnTime}"
                     IsReadOnly="True"/>

            <!-- Deliveries Late -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Deliveries Late:"/>
            <TextBox Grid.Row="10" Grid.Column="1"
                     Text="{Binding CurrentCourier.DeliveriesCountLate}"
                     IsReadOnly="True"/>

            <!-- Current Order -->
            <TextBlock Grid.Row="11" Grid.Column="0" Text="Current Order ID:"/>
            <TextBox Grid.Row="11" Grid.Column="1"
                     Text="{Binding CurrentCourier.CurrentOrder.OrderId}"
                     IsReadOnly="True"/>

            <!-- ================= ACTION BUTTON ================= -->

            <Button Grid.Row="12" Grid.ColumnSpan="2"
                    Content="{Binding ButtonText}"
                    Height="40"
                    Width="140"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="btnAddUpdate_Click"/>

        </Grid>
    </ScrollViewer>
</Window>
