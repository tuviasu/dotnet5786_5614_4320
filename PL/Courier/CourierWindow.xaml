<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        mc:Ignorable="d"
        Title="CourierWindow" Height="520" Width="400"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <!-- External Grid -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <!-- Title-->
            <RowDefinition Height="30"/>
            <!-- Courier ID -->
            <RowDefinition Height="30"/>
            <!-- Full Name -->
            <RowDefinition Height="30"/>
            <!-- Phone -->
            <RowDefinition Height="30"/>
            <!-- Email -->
            <RowDefinition Height="30"/>
            <!-- Start Work in company -->
            <RowDefinition Height="30"/>
            <!-- Transport Type -->
            <RowDefinition Height="30"/>
            <!-- Password -->
            <RowDefinition Height="30"/>
            <!-- Is Active -->
            <RowDefinition Height="30"/>
            <!-- Max delivery distance -->
            <RowDefinition Height="30"/>
            <!-- Delivery Type -->
            <RowDefinition Height="30"/>
            <!-- total orders delivered on time -->
            <RowDefinition Height="30"/>
            <!-- total orders delivered late -->
            <RowDefinition Height="30"/>
            <!-- current order id in progress -->
            <RowDefinition Height="53*"/>
            <RowDefinition Height="12*"/>
            <!-- Button space -->

        </Grid.RowDefinitions>

        <!--Add new courier or update existing one-->
        <Button Content="{Binding ButtonText}" Click="btnAddOrUpdate_Click" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Row="14" VerticalAlignment="Top" Width="70" Height="30" Margin="165,17,0,0"/>


        <Label Content="Courier ID:"                    HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="1"  VerticalAlignment="Center"/>
        <Label Content="Full Name:"                     HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="2"  VerticalAlignment="Center"/>
        <Label Content="Phone number:"                  HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="3"  VerticalAlignment="Center"/>
        <Label Content="Email:"                         HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="4"  VerticalAlignment="Center"/>
        <Label Content="Start work in company:"         HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="5"  VerticalAlignment="Center"/>
        <Label Content="Transport type:"                HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="6"  VerticalAlignment="Center"/>
        <Label Content="Password:"                      HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="7"  VerticalAlignment="Center"/>
        <Label Content="Is active:"                     HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="8"  VerticalAlignment="Center"/>
        <Label Content="Max delivery distance(Km):"     HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="9"  VerticalAlignment="Center"/>
        <Label Content="Delivery type:"                 HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="10" VerticalAlignment="Center"/>
        <Label Content="Delivered on time:"             HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="11" VerticalAlignment="Center"/>
        <Label Content="Delivered late:"                HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="12" VerticalAlignment="Center"/>
        <Label Content="Current order ID in progress:"  HorizontalAlignment="Left" Margin="30,0,0,0" Grid.Row="13" VerticalAlignment="Center"/>

        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.CourierID}" IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="2"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="3"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="4"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <DatePicker Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="5"  VerticalAlignment="Center" Width="150" SelectedDate="{Binding CurrentCourier.StartWorkInCompany, Mode=TwoWay}"/>
        <ComboBox   Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="6"  VerticalAlignment="Center" Width="150" ItemsSource="{Binding Source={StaticResource DeliveryTransportKey}}" SelectedValue="{Binding CurrentCourier.TransportType, Mode=TwoWay}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="7"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox   Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="8"  VerticalAlignment="Center" Width="150" IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="9"  VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.MaxDeliveryDistanceKM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox   Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="10" VerticalAlignment="Center" Width="150" ItemsSource="{Binding Source={StaticResource DeliveryTypeKey}}" SelectedValue="{Binding CurrentCourier.DeliveryType, Mode=TwoWay}" IsEnabled="{Binding ButtonText, Converter={StaticResource ConvertAddToFalseKey}}"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="11" VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.DeliveredInTime}" IsReadOnly="True"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="12" VerticalAlignment="Center" Width="150" Text="{Binding CurrentCourier.DeliveredNotInTime}" IsReadOnly="True"/>
        <TextBox    Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="13" VerticalAlignment="Center" Width="150" Text="{Binding CurrentOrderID, Mode=TwoWay}" IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertAddToTrueKey}}"/>
    </Grid>
</Window>
