<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Courier Profile"
        Height="540"
        Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#ECEFF1"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- HEADER -->
            <Border Background="#263238"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,18">
                <TextBlock Text="Courier Profile"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- SECTION : PERSONAL -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>

                    <TextBlock Text="Personal Information"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Courier ID"/>
                    <TextBox Text="{Binding CurrentCourier.CourierID}"
                             IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertUpdateToTrueKey}}"/>

                    <TextBlock Text="Full Name" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phone" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Password" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>
            </Border>

            <!-- SECTION : WORK -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>

                    <TextBlock Text="Work Details"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Start Date"/>
                    <DatePicker SelectedDate="{Binding CurrentCourier.StartWorkInCompany, Mode=TwoWay}"/>

                    <TextBlock Text="Transport Type" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DeliveryTransportKey}}"
                              SelectedValue="{Binding CurrentCourier.TransportType, Mode=TwoWay}"/>

                    <TextBlock Text="Delivery Type" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource DeliveryTypeKey}}"
                              SelectedValue="{Binding CurrentCourier.DeliveryType, Mode=TwoWay}"
                              IsEnabled="{Binding ButtonText, Converter={StaticResource ConvertAddToFalseKey}}"/>

                    <TextBlock Text="Max Distance (Km)" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.MaxDeliveryDistanceKM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox Content="Courier is active"
                              Margin="0,10,0,0"
                              IsChecked="{Binding CurrentCourier.IsActive, Mode=TwoWay}"/>

                </StackPanel>
            </Border>

            <!-- SECTION : STATISTICS -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>

                    <TextBlock Text="Statistics"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Delivered On Time"/>
                    <TextBox Text="{Binding CurrentCourier.DeliveredInTime}" IsReadOnly="True"/>

                    <TextBlock Text="Delivered Late" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentCourier.DeliveredNotInTime}" IsReadOnly="True"/>

                    <TextBlock Text="Current Order ID" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding CurrentOrderID, Mode=TwoWay}"
                             IsReadOnly="{Binding ButtonText, Converter={StaticResource ConvertAddToTrueKey}}"/>

                </StackPanel>
            </Border>

            <!-- ACTION BUTTON -->
            <Button Content="{Binding ButtonText}"
                    Height="38"
                    Margin="0,10,0,10"
                    Click="btnAddOrUpdate_Click"
                    Background="#1976D2"
                    Foreground="White"
                    FontWeight="Bold"/>

        </StackPanel>
    </ScrollViewer>
</Window>
