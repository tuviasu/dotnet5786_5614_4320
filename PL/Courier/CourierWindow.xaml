<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Courier Details"
        Height="780"
        Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <!-- ========= RESOURCES ========= -->
    <Window.Resources>

        <!-- Enum Sources -->
        <ObjectDataProvider x:Key="TransportValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:DeliveryTransport"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="AdministratorValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:Administrator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Typography -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263238"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#607D8B"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CFD8DC"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- ========= LAYOUT ========= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <TextBlock Text="Courier Details"
                       Style="{StaticResource TitleStyle}"
                       Margin="0,0,0,25"/>

            <!-- ===== PERSONAL INFO ===== -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Personal Information"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Courier ID" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.Id}"
                             IsReadOnly="{Binding isReadOnly}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Phone" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.Phone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== WORK SETTINGS ===== -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Work Settings"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Transport" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource TransportValues}}"
                              SelectedItem="{Binding CourierCurrent.Transport}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Max Distance (km)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.MaxDistance}"
                             Margin="0,4,0,12"/>

                    <CheckBox Content="Active courier"
                              IsChecked="{Binding CourierCurrent.IsActive}"/>
                </StackPanel>
            </Border>

            <!-- ===== SYSTEM SETTINGS ===== -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,30">

                <StackPanel>
                    <TextBlock Text="System Settings"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Role" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource AdministratorValues}}"
                              SelectedItem="{Binding CourierCurrent.Administrator}"
                              IsReadOnly="{Binding isReadOnly}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Start Date" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding CourierCurrent.StartDate, StringFormat={}{0:dd/MM/yyyy}}"
                             IsReadOnly="{Binding isReadOnly}"/>
                </StackPanel>
            </Border>

            <!-- ===== ACTIONS ===== -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,12,0"
                        Click="btnCancel_Click"/>

                <Button Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        Click="btnSave_Click"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
