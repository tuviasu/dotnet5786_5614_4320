<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="System Management Dashboard"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F8"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- ===================== -->
    <!-- Resources             -->
    <!-- ===================== -->
    <Window.Resources>

        <!-- Clock format converter -->
        <local:ForceDataFormatConverter x:Key="ForceDataFormatConverter"/>

        <!-- Card container -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main button -->
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== -->
    <!-- Main Layout Grid      -->
    <!-- ===================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Clock -->
            <RowDefinition Height="Auto"/>
            <!-- Configuration -->
            <RowDefinition Height="Auto"/>
            <!-- Orders Summary -->
            <RowDefinition Height="Auto"/>
            <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- Clock Section         -->
        <!-- ===================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="System Clock"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding CurrentTime, Converter={StaticResource ForceDataFormatConverter}}"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,10"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="+ Minute" Style="{StaticResource MainButton}" Margin="6"
                            Click="btnAddOneMinute_Click"/>
                    <Button Content="+ Hour" Style="{StaticResource MainButton}" Margin="6"
                            Click="btnAddOneHour_Click"/>
                    <Button Content="+ Day" Style="{StaticResource MainButton}" Margin="6"
                            Click="btnAddOneDay_Click"/>
                    <Button Content="+ Month" Style="{StaticResource MainButton}" Margin="6"

                            Click="btnAddOneMonth_Click"/>
                    <Button Content="+ Year" Style="{StaticResource MainButton}" Margin="6"
                            Click="btnAddOneYear_Click"/>
                </WrapPanel>

            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- Configuration Section -->
        <!-- ===================== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackPanel>

                <TextBlock Text="System Configuration"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Delivery Distance" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,4"
                               Style="{StaticResource AppTextBox}"
                               Text="{Binding EditableMaxDeliveryDistance}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Delivery Time" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,4"
                               Style="{StaticResource AppTextBox}"
                               Text="{Binding EditableMaxDeliveryTimeRange}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Risk Range" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,4"
                               Style="{StaticResource AppTextBox}"
                               Text="{Binding EditableRiskRange}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Inactivity Time" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,4"
                               Style="{StaticResource AppTextBox}"
                               Text="{Binding EditableInactivityTimeRange}"/>
                </Grid>

                <!-- Single update button -->
                <Button Content="Update Configuration"
                        Style="{StaticResource MainButton}"
                        HorizontalAlignment="Center"
                        Click="btnUpdateConfig_Click"/>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- Orders Summary        -->
        <!-- ===================== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>

                <TextBlock Text="Orders Summary"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <WrapPanel VerticalAlignment="Center">

                    <ComboBox Width="200"
                              SelectedItem="{Binding SelectedSummaryDeliveryDoneType}">
                        <ComboBoxItem Content="Delivery Done Type" IsSelected="True"/>
                        <ComboBoxItem Content="Delivered"/>
                        <ComboBoxItem Content="CustomerRefused"/>
                        <ComboBoxItem Content="Cancelled"/>
                        <ComboBoxItem Content="CustomerNotFound"/>
                        <ComboBoxItem Content="Failed"/>
                    </ComboBox>

                    <ComboBox Width="200" Margin="10,0,0,0"
                              SelectedItem="{Binding SelectedSummaryScheduleStatus}">
                        <ComboBoxItem Content="Schedule Status" IsSelected="True"/>
                        <ComboBoxItem Content="OnTime"/>
                        <ComboBoxItem Content="InRisk"/>
                        <ComboBoxItem Content="Late"/>
                    </ComboBox>

                    <Button Content="Apply Filter"
                            Style="{StaticResource MainButton}"
                            Margin="10,0,0,0"
                            Click="SummaryFilter_Click"/>

                    <Button Content="{Binding SummaryFilteredCount}"
                            Style="{StaticResource MainButton}"
                            Margin="10,0,0,0"
                            MinWidth="80"
                            Click="SummaryFilteredCount_Click"/>
                </WrapPanel>

            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- Actions Section       -->
        <!-- ===================== -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <WrapPanel HorizontalAlignment="Center">

                <Button Content="Courier List"
                        Style="{StaticResource MainButton}"
                        Margin="8"
                        Click="btnCouriersListWindow_Click"/>

                <Button Content="Order List"
                        Style="{StaticResource MainButton}"
                        Margin="8"
                        Click="btnOrdersListWindow_Click"/>

                <Button Content="Init DB"
                        Background="#2ECC71"
                        Style="{StaticResource MainButton}"
                        Margin="8"
                        Click="btnInitDB_Click"/>

                <Button Content="Reset DB"
                        Background="#E74C3C"
                        Style="{StaticResource MainButton}"
                        Margin="8"
                        Click="btnResetDB_Click"/>

                <Button Content="Log Out"
                        Background="#555"
                        Style="{StaticResource MainButton}"
                        Margin="8"
                        Click="btnLOGOUT_Click"/>
            </WrapPanel>
        </Border>

    </Grid>
</Window>
