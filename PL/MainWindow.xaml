<Window x:Class="PL.MainWindow"        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"        xmlns:local="clr-namespace:PL"        Loaded="MainWindow_Loaded"        Closed="MainWindow_Closed"        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"        mc:Ignorable="d"        Title="MainWindow" Height="450" Width="800">    <Grid>        <Grid.RowDefinitions>            <RowDefinition Height="Auto" MinHeight="22"/>            <RowDefinition/>            <RowDefinition Height="Auto"/>        </Grid.RowDefinitions>        <!-- System clock area -->        <Grid Grid.Row="0" Margin="10">            <Grid.ColumnDefinitions>                <ColumnDefinition Width="*"/>                <ColumnDefinition Width="Auto"/>            </Grid.ColumnDefinitions>            <!-- Current system clock display -->            <Label Grid.Column="0"                  Content="{Binding CurrentTime, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"                  FontWeight="Bold"                  FontSize="20"/>            <!-- Clock advance buttons -->            <StackPanel Grid.Column="1"                        Orientation="Horizontal"                        VerticalAlignment="Center">                <Button Content="+1 Minute" Margin="5,0"                        Click="btnAddOneMinute_Click"/>                <Button Content="+1 Hour" Margin="5,0"                        Click="btnAddOneHour_Click"/>                <Button Content="+1 Day" Margin="5,0"                        Click="btnAddOneDay_Click"/>                <Button Content="+1 Month" Margin="5,0"                        Click="btnAddOneMonth_Click"/>                <Button Content="+1 Year" Margin="5,0"                        Click="btnAddOneYear_Click"/>            </StackPanel>        </Grid>        <!-- Config variables area -->        <GroupBox Grid.Row="1" Header="Config Variables" Margin="10">            <GroupBox.Resources>                <!-- Common style for labels -->                <Style TargetType="Label">                    <Setter Property="VerticalAlignment" Value="Center"/>                    <Setter Property="Margin" Value="0,0,10,0"/>                </Style>                <!-- Common style for text boxes -->                <Style TargetType="TextBox">                    <Setter Property="Margin" Value="0,3"/>                    <Setter Property="MinHeight" Value="28"/>                    <Setter Property="VerticalContentAlignment" Value="Center"/>                </Style>            </GroupBox.Resources>            <!-- Scroll is required due to fixed window size -->            <ScrollViewer VerticalScrollBarVisibility="Auto">                <Grid Margin="8">                    <Grid.ColumnDefinitions>                        <ColumnDefinition Width="200"/>                        <ColumnDefinition Width="Auto"/>                    </Grid.ColumnDefinitions>                    <Grid.RowDefinitions>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="28"/>                        <RowDefinition MinHeight="40"/>                    </Grid.RowDefinitions>                    <!-- Company Address -->                    <Label Grid.Row="0" Grid.Column="0" Content="Company Address:"/>                    <TextBox Grid.Row="0" Grid.Column="1"                             Width="250"                             Text="{Binding Configuration.CompanyAddress,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Max Range -->                    <Label Grid.Row="1" Grid.Column="0" Content="Max Delivery Range:"/>                    <TextBox Grid.Row="1" Grid.Column="1"                             Text="{Binding Configuration.MaxRange,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Car Speed -->                    <Label Grid.Row="2" Grid.Column="0" Content="Car Speed (km/h):"/>                    <TextBox Grid.Row="2" Grid.Column="1"                             Text="{Binding Configuration.AvgCarSpeed,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Motorbike Speed -->                    <Label Grid.Row="3" Grid.Column="0" Content="Motorbike Speed (km/h):"/>                    <TextBox Grid.Row="3" Grid.Column="1"                             Text="{Binding Configuration.AvgMotorbikeSpeed,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Bicycle Speed -->                    <Label Grid.Row="4" Grid.Column="0" Content="Bicycle Speed (km/h):"/>                    <TextBox Grid.Row="4" Grid.Column="1"                             Text="{Binding Configuration.AvgBicycleSpeed,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Walking Speed -->                    <Label Grid.Row="5" Grid.Column="0" Content="Walking Speed (km/h):"/>                    <TextBox Grid.Row="5" Grid.Column="1"                             Text="{Binding Configuration.AvgWalkingSpeed,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Max Delivery Time -->                    <Label Grid.Row="6" Grid.Column="0" Content="Max Delivery Time (hh:mm:ss):"/>                    <TextBox Grid.Row="6" Grid.Column="1"                             Text="{Binding Configuration.MaxDeliveryTime,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Risk Range -->                    <Label Grid.Row="7" Grid.Column="0" Content="Risk Range (hh:mm:ss):"/>                    <TextBox Grid.Row="7" Grid.Column="1"                             Text="{Binding Configuration.RiskRange,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Inactivity Range -->                    <Label Grid.Row="8" Grid.Column="0" Content="Inactivity Range (hh:mm:ss):"/>                    <TextBox Grid.Row="8" Grid.Column="1"                             Text="{Binding Configuration.InactivityRange,                                    UpdateSourceTrigger=PropertyChanged}"/>                    <!-- Update button -->                    <Button Grid.Row="9" Grid.Column="1"                            Content="Update Config"                            Width="140"                            Height="34"                            HorizontalAlignment="Right"                            Margin="0,8,0,0"                            Click="UpdateConfig_Click"/>                </Grid>            </ScrollViewer>        </GroupBox>        <!-- Main navigation button: open courier list -->        <StackPanel Grid.Row="2"                    Orientation="Horizontal"                    HorizontalAlignment="Center"                    Margin="10">            <Button Content="Manage Couriers"                    Width="180"                    Height="45"                    Click="OpenCouriersList_Click"/>                                    <Button Content="Initialize DB"                    Click="btnInitializeDb_Click"                    Width="160"                    Height="45"                    Margin="10,0" />                           <Button Content="Reset DB"                    Click="btnResetDb_Click"                    Width="140"                    Height="45"                    Background="LightCoral"/>        </StackPanel>    </Grid></Window>