<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delivery Management System"
        Width="1400" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="TimeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#0D9488"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#475569"/>
        </Style>

    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ROW 1 : CLOCK ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="System Clock" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                           FontSize="30"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <UniformGrid Columns="5">
                    <Button Content="+ 1 Minute" Style="{StaticResource TimeButton}" Click="AddOneMinute_Click"/>
                    <Button Content="+ 1 Hour"   Style="{StaticResource TimeButton}" Click="AddOneHour_Click"/>
                    <Button Content="+ 1 Day"    Style="{StaticResource TimeButton}" Click="AddOneDay_Click"/>
                    <Button Content="+ 1 Month"  Style="{StaticResource TimeButton}" Click="AddOneMonth_Click"/>
                    <Button Content="+ 1 Year"   Style="{StaticResource TimeButton}" Click="AddOneYear_Click"/>
                </UniformGrid>

            </StackPanel>
        </Border>

        <!-- ================= ROW 2 : CONFIG ================= -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <ScrollViewer>
                <StackPanel>

                    <TextBlock Text="System Configuration" Style="{StaticResource HeaderText}"/>

                    <TextBlock Text="Boss ID" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding Configuration.BossId, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"/>

                    <TextBlock Text="Boss Password" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding Configuration.BossPassword, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Car Speed" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Configuration.CarSpeed}"/>

                    <TextBlock Text="Motorcycle Speed" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Configuration.MotorcycleSpeed}"/>

                    <TextBlock Text="Bike Speed" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Configuration.BikeSpeed}"/>

                    <TextBlock Text="Walking Speed" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Configuration.WalkingSpeed}"/>

                    <TextBlock Text="Company Address" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding Configuration.CompanyAddress}"/>

                    <Button Content="Apply Configuration"
                            Style="{StaticResource PrimaryButton}"
                            Background="#0D9488"
                            Click="ApplyConfig_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= ROW 3 : ACTIONS ================= -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <UniformGrid Columns="4">

                <Button Content="Couriers List"
                        Style="{StaticResource ActionButton}"
                        Click="CouriersList_Click"/>

                <Button Content="Orders List"
                        Style="{StaticResource ActionButton}"
                        Click="OrdersList_Click"/>

                <Button Content="Initialize Database"
                        Style="{StaticResource PrimaryButton}"
                        Background="#F59E0B"
                        Click="InitDB_Click"/>

                <Button Content="Reset Database"
                        Style="{StaticResource PrimaryButton}"
                        Background="#DC2626"
                        Click="ResetDB_Click"/>

            </UniformGrid>
        </Border>

    </Grid>
</Window>
