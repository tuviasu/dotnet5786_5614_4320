<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="System Management Dashboard"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F8"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- ===================== -->
    <!-- Resources             -->
    <!-- ===================== -->
    <Window.Resources>

        <local:ForceDataFormatConverter x:Key="ForceDataFormatConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#4F6EF7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4"/>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Foreground="#999"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ===================== -->
    <!-- Layout                -->
    <!-- ===================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- Clock Section         -->
        <!-- ===================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="System Clock"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding CurrentTime, Converter={StaticResource ForceDataFormatConverter}}"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,6"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="+ Minute" Style="{StaticResource MainButton}" Margin="4" Click="btnAddOneMinute_Click"/>
                    <Button Content="+ Hour"   Style="{StaticResource MainButton}" Margin="4" Click="btnAddOneHour_Click"/>
                    <Button Content="+ Day"    Style="{StaticResource MainButton}" Margin="4" Click="btnAddOneDay_Click"/>
                    <Button Content="+ Month"  Style="{StaticResource MainButton}" Margin="4" Click="btnAddOneMonth_Click"/>
                    <Button Content="+ Year"   Style="{StaticResource MainButton}" Margin="4" Click="btnAddOneYear_Click"/>

                    <!-- RESET CLOCK BUTTON -->
                    <Button Content="Reset System Clock"
                            Style="{StaticResource MainButton}"
                            Background="#FFB74D"
                            Foreground="Black"
                            Margin="12,4"
                            Click="ResetClock_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- Middle Section        -->
        <!-- ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuration -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="System Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Distance"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding EditableMaxDeliveryDistance}" Tag="km"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Time"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding EditableMaxDeliveryTimeRange}" Tag="hh:mm:ss"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Risk Range"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding EditableRiskRange}" Tag="hh:mm:ss"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Inactivity"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource WatermarkTextBox}"
                                 Text="{Binding EditableInactivityTimeRange}" Tag="hh:mm:ss"/>
                    </Grid>

                    <Button Content="Update Configuration"
                            Style="{StaticResource MainButton}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Click="btnUpdateConfig_Click"/>
                </StackPanel>
            </Border>

            <!-- Orders Summary -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Orders Summary" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ComboBox Margin="0,4" SelectedItem="{Binding SelectedSummaryDeliveryDoneType}">
                        <ComboBoxItem Content="Delivery Done Type" IsSelected="True"/>
                        <ComboBoxItem Content="Delivered"/>
                        <ComboBoxItem Content="CustomerRefused"/>
                        <ComboBoxItem Content="Cancelled"/>
                        <ComboBoxItem Content="CustomerNotFound"/>
                        <ComboBoxItem Content="Failed"/>
                    </ComboBox>

                    <ComboBox Margin="0,4" SelectedItem="{Binding SelectedSummaryScheduleStatus}">
                        <ComboBoxItem Content="Schedule Status" IsSelected="True"/>
                        <ComboBoxItem Content="OnTime"/>
                        <ComboBoxItem Content="InRisk"/>
                        <ComboBoxItem Content="Late"/>
                    </ComboBox>

                    <WrapPanel Margin="0,8">
                        <Button Content="Apply Filter" Style="{StaticResource MainButton}" Click="SummaryFilter_Click"/>
                        <Button Content="{Binding SummaryFilteredCount}" Style="{StaticResource MainButton}"
                                Margin="8,0,0,0" Click="SummaryFilteredCount_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== -->
        <!-- Actions Section       -->
        <!-- ===================== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Courier List" Style="{StaticResource MainButton}" Margin="6" Click="btnCouriersListWindow_Click"/>
                <Button Content="Order List"   Style="{StaticResource MainButton}" Margin="6" Click="btnOrdersListWindow_Click"/>
                <Button Content="Init DB" Background="#2ECC71" Style="{StaticResource MainButton}" Margin="6" Click="btnInitDB_Click"/>
                <Button Content="Reset DB" Background="#E74C3C" Style="{StaticResource MainButton}" Margin="6" Click="btnResetDB_Click"/>
                <Button Content="Log Out" Background="#555" Style="{StaticResource MainButton}" Margin="6" Click="btnLOGOUT_Click"/>
            </WrapPanel>
        </Border>

    </Grid>
</Window>
