<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="DeliveryApp - Management Dashboard"
        Width="1000"
        Height="780"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F8"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- ===================== -->
    <!-- Resources             -->
    <!-- ===================== -->
    <Window.Resources>

        <!-- Clock format converter -->
        <local:ForceDataFormatConverter x:Key="ForceDataFormatConverter"/>

        <!-- Card container -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main button -->
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Summary metric tile (clickable -> opens OrderListWindow filtered) -->
        <Style x:Key="SummaryTileStyle" TargetType="Button">
            <Setter Property="Width" Value="138"/>
            <Setter Property="Margin" Value="8,8,8,8"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Click to view these orders in the Order Management window"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tileBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="tileBorder" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Count value inside a tile -->
        <Style x:Key="TileCountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Label inside a tile -->
        <Style x:Key="TileLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- ===================== -->
    <!-- Scrollable root       -->
    <!-- ===================== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Clock -->
                <RowDefinition Height="Auto"/> <!-- Configuration -->
                <RowDefinition Height="Auto"/> <!-- Orders Summary -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- ===================== -->
            <!-- Clock Section         -->
            <!-- ===================== -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="System Clock"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding CurrentTime, Converter={StaticResource ForceDataFormatConverter}}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,10"/>

                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="+ Minute" Style="{StaticResource MainButton}" Margin="6"
                                Click="btnAddOneMinute_Click"/>
                        <Button Content="+ Hour" Style="{StaticResource MainButton}" Margin="6"
                                Click="btnAddOneHour_Click"/>
                        <Button Content="+ Day" Style="{StaticResource MainButton}" Margin="6"
                                Click="btnAddOneDay_Click"/>
                        <Button Content="+ Month" Style="{StaticResource MainButton}" Margin="6"
                                Click="btnAddOneMonth_Click"/>
                        <Button Content="+ Year" Style="{StaticResource MainButton}" Margin="6"
                                Click="btnAddOneYear_Click"/>
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- ===================== -->
            <!-- Configuration Section -->
            <!-- ===================== -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel>

                    <TextBlock Text="System Configuration"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Delivery Distance (km)" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,4">
                            <TextBox   x:Name="tbMaxDeliveryDistance"
                                       Style="{StaticResource AppValidatedTextBox}"
                                       Text="{Binding EditableMaxDeliveryDistance, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Enter a positive distance, e.g. 30"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max Delivery Time" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <TextBox   x:Name="tbMaxDeliveryTime"
                                       Style="{StaticResource AppValidatedTextBox}"
                                       Text="{Binding EditableMaxDeliveryTimeRangeText, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Format: hh:mm:ss, e.g. 01:30:00"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Risk Range" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <TextBox   x:Name="tbRiskRange"
                                       Style="{StaticResource AppValidatedTextBox}"
                                       Text="{Binding EditableRiskRangeText, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Format: hh:mm:ss, e.g. 00:15:00"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Inactivity Time" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                            <TextBox   x:Name="tbInactivityTime"
                                       Style="{StaticResource AppValidatedTextBox}"
                                       Text="{Binding EditableInactivityTimeRangeText, ValidatesOnNotifyDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Format: hh:mm:ss, e.g. 08:00:00"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Single update button: disabled while any config field has a validation error -->
                    <Button Content="Update Configuration"
                            Style="{StaticResource MainButton}"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding HasErrors, Converter={StaticResource InverseBooleanKey}}"
                            Click="btnUpdateConfig_Click"/>
                </StackPanel>
            </Border>

            <!-- ===================== -->
            <!-- Orders Summary        -->
            <!-- ===================== -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel>

                    <TextBlock Text="Orders Summary"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Click any metric to open the matching orders"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,0,0,10"/>

                    <!-- Metric tiles (bound to BL summary counts, click opens filtered OrderListWindow) -->
                    <WrapPanel>
                        <Button Tag="" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.Total}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Total Orders" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="NotDelivered" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.NotDelivered}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Not Delivered" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Delivered" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.Delivered}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Delivered" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="CustomerRefused" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.Refused}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Customer Refused" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Cancelled" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.Cancelled}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Cancelled" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="InRisk" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.InRisk}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="In Risk" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="Late" Style="{StaticResource SummaryTileStyle}" Click="SummaryTile_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Summary.Late}" Style="{StaticResource TileCountText}"/>
                                <TextBlock Text="Late" Style="{StaticResource TileLabelText}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Manual filter (still available) -->
                    <TextBlock Text="Manual Filter"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,14,0,6"/>
                    <WrapPanel VerticalAlignment="Center">
                        <ComboBox Width="200"
                                  SelectedItem="{Binding SelectedSummaryDeliveryDoneType}">
                            <ComboBoxItem Content="Delivery Done Type" IsSelected="True"/>
                            <ComboBoxItem Content="Delivered"/>
                            <ComboBoxItem Content="CustomerRefused"/>
                            <ComboBoxItem Content="Cancelled"/>
                            <ComboBoxItem Content="CustomerNotFound"/>
                            <ComboBoxItem Content="Failed"/>
                        </ComboBox>

                        <ComboBox Width="200" Margin="10,0,0,0"
                                  SelectedItem="{Binding SelectedSummaryScheduleStatus}">
                            <ComboBoxItem Content="Schedule Status" IsSelected="True"/>
                            <ComboBoxItem Content="OnTime"/>
                            <ComboBoxItem Content="InRisk"/>
                            <ComboBoxItem Content="Late"/>
                        </ComboBox>

                        <Button Content="Apply Filter"
                                Style="{StaticResource MainButton}"
                                Margin="10,0,0,0"
                                Click="SummaryFilter_Click"/>

                        <Button Content="{Binding SummaryFilteredCount}"
                                Style="{StaticResource MainButton}"
                                Margin="10,0,0,0"
                                MinWidth="80"
                                Click="SummaryFilteredCount_Click"/>
                    </WrapPanel>

                </StackPanel>
            </Border>

            <!-- ===================== -->
            <!-- Actions Section       -->
            <!-- ===================== -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <WrapPanel HorizontalAlignment="Center">

                    <Button Content="Courier List"
                            Style="{StaticResource MainButton}"
                            Margin="8"
                            Click="btnCouriersListWindow_Click"/>

                    <Button Content="Order List"
                            Style="{StaticResource MainButton}"
                            Margin="8"
                            Click="btnOrdersListWindow_Click"/>

                    <Button Content="Init DB"
                            Background="#2ECC71"
                            Style="{StaticResource MainButton}"
                            Margin="8"
                            Click="btnInitDB_Click"/>

                    <Button Content="Reset DB"
                            Background="#E74C3C"
                            Style="{StaticResource MainButton}"
                            Margin="8"
                            Click="btnResetDB_Click"/>

                    <Button Content="Log Out"
                            Background="#555"
                            Style="{StaticResource MainButton}"
                            Margin="8"
                            Click="btnLOGOUT_Click"/>
                </WrapPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>