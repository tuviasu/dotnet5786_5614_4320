<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:bo="clr-namespace:BO;assembly=BL"
        mc:Ignorable="d"
        Title="Order Details"
        Height="800"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <!-- ========= RESOURCES ========= -->
    <Window.Resources>

        <!-- Enum Sources -->
        <ObjectDataProvider x:Key="OrderTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:OrderType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="FragilityValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:FragilityLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ShedulStatus"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="bo:ScheduleStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Typography -->
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#263238"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#607D8B"/>
        </Style>

        <!-- Inputs -->
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CFD8DC"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- ========= LAYOUT ========= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <TextBlock Text="Order Details"
                       Style="{StaticResource TitleStyle}"
                       Margin="0,0,0,25"/>

            <!-- ===== ORDER OVERVIEW ===== -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Order Overview"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Order ID" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.Id}" IsReadOnly="True" Margin="0,4,0,12"/>

                    <TextBlock Text="Order Type" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource OrderTypeValues}}"
                              SelectedItem="{Binding OrderCurrent.Type}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Order Date" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                             IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <!-- ===== CUSTOMER DETAILS ===== -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Customer Details"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Customer Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Customer Phone" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Delivery Address" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.CustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="70"/>
                </StackPanel>
            </Border>

            <!-- ===== PACKAGE DETAILS ===== -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Package Details"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Weight (kg)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.Weight, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Volume" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.Volume, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Fragility Level" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource FragilityValues}}"
                              SelectedItem="{Binding OrderCurrent.Fragility}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.OrderDescription, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="80"/>
                </StackPanel>
            </Border>

            <!-- ===== STATUS & SCHEDULE ===== -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="Status &amp; Schedule"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Status" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.Status}" IsReadOnly="True" Margin="0,4,0,12"/>

                    <TextBlock Text="Distance (km)" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.Distance, StringFormat={}{0:0.0}}"
                             IsReadOnly="True"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Estimated Arrival" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.ArrivalDateEstimeted, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                             IsReadOnly="True"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Max Arrival Date" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding OrderCurrent.ArrivalDateMax, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                             IsReadOnly="True"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="Schedule Status" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource ShedulStatus}}"
                              SelectedItem="{Binding OrderCurrent.ScheduleStatus}"
                              IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- ===== ACTIONS ===== -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="0,0,12,0"
                        Click="btnCancel_Click"/>

                <Button Content="Save"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120"
                        Click="btnSave_Click"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
