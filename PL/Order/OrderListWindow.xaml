<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        Title="Order Management"
        Height="640"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F5"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">

                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Filter by"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="180"
                              Height="34"
                              ItemsSource="{Binding Source={StaticResource OrderListFilterPropertyKey}}"
                              SelectedValue="{Binding FilterProperty, Mode=TwoWay}"
                              SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Value"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="200"
                              Height="34"
                              ItemsSource="{Binding FilterValues}"
                              SelectedItem="{Binding FilterValue, Mode=TwoWay}"
                              SelectionChanged="FilterChanged"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Sort by"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <ComboBox Width="180"
                              Height="34"
                              ItemsSource="{Binding Source={StaticResource OrderListSortPropertyKey}}"
                              SelectedValue="{Binding SortProperty, Mode=TwoWay}"
                              SelectionChanged="FilterChanged"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Orders Table -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="12">

            <DataGrid ItemsSource="{Binding OrderList}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="Update_DoubleClick"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowBackground="#F9FBFC"
                      AlternatingRowBackground="#EDF3F7"
                      FontSize="13">

                <!-- FIXED HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                        <Setter Property="MinHeight" Value="42"/>
                        <Setter Property="Background" Value="#E3EAF0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID"
                                        Binding="{Binding OrderID}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Delivery ID"
                                        Binding="{Binding DeliveryID}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding orderType}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding orderStatus}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Schedule"
                                        Binding="{Binding scheduleStatus}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Deliveries"
                                        Binding="{Binding TotalDeliveries}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Remaining Time"
                                        Binding="{Binding TimeRemainingToComplete, Converter={StaticResource TimeSpanToReadableConverter}}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Handling Time"
                                        Binding="{Binding TotalHandlingTime, Converter={StaticResource TimeSpanToReadableConverter}}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Air Distance (km)"
                                        Binding="{Binding AirDistance}"
                                        Width="140"/>

                    <!-- Cancel button stays RED -->
                    <DataGridTemplateColumn Header="Cancel"
                                            Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel"
                                        Click="btnCancel_Click"
                                        Style="{StaticResource AppDangerButton}"
                                        MinHeight="0"
                                        Height="30"
                                        Padding="12,4"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Visibility="{Binding orderStatus,
                                            Converter={StaticResource OrderStatusToCancelVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Add Button -->
        <Button Grid.Row="2"
                Content="+ Add Order"
                Width="200"
                Height="46"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Style="{StaticResource AppSuccessButton}"
                Cursor="Hand"
                Click="btnAdd_Click"/>
    </Grid>
</Window>
