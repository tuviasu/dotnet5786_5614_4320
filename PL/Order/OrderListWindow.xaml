<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Orders Dashboard"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <!-- ========= RESOURCES ========= -->
    <Window.Resources>

        <!-- Header -->
        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Toolbar -->
        <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#455A64"/>
        </Style>

        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="CleanDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Floating Add Button -->
        <Style x:Key="FloatingButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ========= LAYOUT ========= -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#263238" Offset="0"/>
                    <GradientStop Color="#455A64" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Margin="40"
                        VerticalAlignment="Center">
                <TextBlock Text="Order Management"
                           Style="{StaticResource HeaderTitleStyle}"/>

                <TextBlock Text="Tracking and processing overview"
                           FontSize="14"
                           Foreground="#CFD8DC"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="30,-40,30,20">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Filter by status:"
                           Style="{StaticResource ToolbarLabelStyle}"
                           Margin="0,0,15,0"/>

                <ComboBox Style="{StaticResource FlatComboBoxStyle}"
                          Width="220"
                          ItemsSource="{Binding Source={StaticResource OrderStatusCollectionKey}}"
                          SelectedValue="{Binding OrderStatus, Mode=TwoWay}"
                          SelectionChanged="OrderStatusFilter_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- ===== DATA GRID ===== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="30,0,30,30">

            <DataGrid Style="{StaticResource CleanDataGridStyle}"
                      ItemsSource="{Binding OrderList}"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="dgOrderList_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="90"/>
                    <DataGridTextColumn Header="Delivery ID" Binding="{Binding DeliveryId}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="Distance (km)"
                                        Binding="{Binding Distance, StringFormat={}{0:0.0}}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleStatus}" Width="130"/>
                    <DataGridTextColumn Header="Order Time" Binding="{Binding OrderEndTime}" Width="130"/>
                    <DataGridTextColumn Header="Treatment Time" Binding="{Binding TreatmentEndTime}" Width="150"/>
                    <DataGridTextColumn Header="Couriers" Binding="{Binding NumberOfCouriers}" Width="90"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== FLOATING ADD BUTTON ===== -->
        <Button Grid.Row="2"
                Content="+"
                Style="{StaticResource FloatingButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,50,50"
                Click="btnNewOrder_Click"/>

    </Grid>
</Window>
